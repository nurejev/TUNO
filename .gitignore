node_modules/
js/authConfig.local.js

# Customer brandings — offline only, never published from this repo. Each
# holds a selfhost-branding.json (plus source artwork) that the customer
# serves on their own self-hosted instance; built the way ENCA's local copies
# are (the TUNO mark recoloured per customer, 2 Oct 2026).
/dovilo/
/pvm/
/cloudfellows/

# Terraform deployment of the self-hosting image — offline only, as ENCA keeps
# its own. It names a subscription, a service connection and an app
# registration, and it is not a TUNO change: no changelog entry, no
# promotion-queue item, no build number. It is its own git repo pushed to
# Azure Repos, so the nested .git lives in here too. The image, the entrypoint
# and selfhost/ are the published route (SELF-HOSTING.md).
/terraform/

# Claude working output — never part of a build. Mockups, handover mboxes,
# build briefs, runbooks and review drafts land in "Claude outputs/" (was only
# in .git/info/exclude, so a fresh clone or a cloud session didn't ignore it).
# The loose patterns catch the same files when one is dropped elsewhere.
/Claude outputs/
*.mbox
*.patch
*.rej
*.orig
*-mockup.html
*-build-brief.md
beta-*-brief.md
/.claude/settings.local.json
CLAUDE.local.md

# Per-build review write-ups (Claude-written) — kept on the Mac, not published.
# docs/T28-V2.md stays tracked: js/mderolloutv2.js points to it.
/docs/reviews/
